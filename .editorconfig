root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# The Java here is Google Java Style: 2-space indent, 4-space continuation, 100-column limit.
[*.java]
max_line_length = 100

[*.{xml,properties}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
